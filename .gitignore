# Root-level gitignore — covers the entire monorepo
# ─────────────────────────────────────────────────

# ── Environment files (NEVER commit secrets) ──
.env
.env.*
!.env.example

# ── Node dependencies ──
node_modules/

# ── Logs ──
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build outputs ──
dist/
build/
out/
.next/

# ── OS artifacts ──
.DS_Store
Thumbs.db

# ── IDE ──
.vscode/
.idea/

# ── Test / coverage ──
coverage/
.nyc_output/

# ── Temp upload files ──
backend/public/temp/*
!backend/public/temp/.gitkeep
